<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="JogoController" prefWidth="1050" prefHeight="780"
            style="-fx-background-color: #101724; -fx-font-family: 'SansSerif';">
  <top>
    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #172333;">
      <padding><Insets top="12" bottom="12" right="22" left="22"/></padding>
      <Label fx:id="rotuloAto" text="SANTA AURORA" maxWidth="99999" HBox.hgrow="ALWAYS"
             style="-fx-text-fill: #d8c6a5; -fx-font-weight: bold; -fx-font-size: 16px;"/>
      <Button onAction="#aoStatus" text="Status e inventário"
              style="-fx-background-color: #293a4d; -fx-text-fill: #f1e9dc;"/>
      <Button onAction="#aoMenu" text="Voltar ao menu"
              style="-fx-background-color: #493435; -fx-text-fill: #f1e9dc;"/>
    </HBox>
  </top>
  <center>
    <VBox spacing="12" fillWidth="true">
      <padding><Insets top="22" left="34" right="34" bottom="8"/></padding>
      <StackPane prefHeight="260" minHeight="150" maxHeight="360" VBox.vgrow="NEVER"
                 style="-fx-background-color: linear-gradient(to bottom right, #263849, #111924); -fx-border-color: #3a4a5a; -fx-border-width: 1;">
        <ImageView fx:id="imagemCena" fitWidth="950" fitHeight="260" preserveRatio="true" smooth="true" visible="false"/>
        <Label fx:id="rotuloImagemPendente" text="SANTA AURORA" wrapText="true"
               style="-fx-text-fill: #a9a6a0; -fx-font-size: 18px; -fx-font-weight: bold;"/>
      </StackPane>
      <ScrollPane fx:id="painelDeTexto" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                  style="-fx-background: #101724; -fx-background-color: transparent; -fx-border-color: transparent;">
        <content>
          <VBox spacing="12" style="-fx-background-color: #101724;">
            <padding><Insets top="9" right="12" left="12" bottom="18"/></padding>
            <Label fx:id="rotuloPersonagem" style="-fx-text-fill: #d9b477; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label fx:id="rotuloTexto" wrapText="true" maxWidth="99999"
                   style="-fx-text-fill: #edeae5; -fx-font-size: 18px; -fx-line-spacing: 5px;"/>
          </VBox>
        </content>
      </ScrollPane>
    </VBox>
  </center>
  <bottom>
    <VBox spacing="9" style="-fx-background-color: #172333;">
      <padding><Insets top="10" bottom="16" left="34" right="34"/></padding>
      <Label fx:id="rotuloAviso" wrapText="true" style="-fx-text-fill: #f4a58b; -fx-font-size: 14px;"/>
      <ScrollPane fx:id="painelDeOpcoes" fitToWidth="true" hbarPolicy="NEVER" maxHeight="200"
                  style="-fx-background: #172333; -fx-background-color: transparent; -fx-border-color: transparent;">
        <content>
          <VBox fx:id="caixaDeOpcoes" spacing="8" style="-fx-background-color: #172333;"/>
        </content>
      </ScrollPane>
      <Button fx:id="botaoContinuar" onAction="#aoContinuar" text="Continuar →" minWidth="180"
              style="-fx-background-color: #c5ad83; -fx-text-fill: #14202c; -fx-font-size: 15px; -fx-font-weight: bold;"/>
    </VBox>
  </bottom>
</BorderPane>
